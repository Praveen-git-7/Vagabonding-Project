</form> -->



<div id="filters">
    <a href="/listings/filter/Trending" class="filter" id="Trending">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </a>
    <a href="/listings/filter/Bedroom" class="filter" id="Bedroom">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Bedroom</p>
    </a>
    <a href="/listings/filter/Iconic-Cities" class="filter" id="Iconic-Cities">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
    </a>
    <a href="/listings/filter/Mountains" class="filter" id="Mountains">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </a>
    <a href="/listings/filter/Castles" class="filter" id="Castles">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
    </a>
    <a href="/listings/filter/Amazing-Pool" class="filter" id="Amazing-Pool">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pool</p>
    </a>
    <a href="/listings/filter/Camping" class="filter" id="Camping">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </a>
    <a href="/listings/filter/Farms" class="filter" id="Farms">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
    </a>
    <a href="/listings/filter/Arctic" class="filter" id="Arctic">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
    </a>
    <a href="/listings/filter/Off-Roading" class="filter" id="Off-Roading">
        <div><i class="fa-solid fa-truck-monster"></i></div>
        <p>Off-Roading</p>
    </a>
    <a href="/listings/filter/Domes" class="filter" id="Domes">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
    </a>
    



    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
            <label class="form-check-label" for="flexSwitchCheckDefault">Display with taxes</label>
        </div>
    </div>
</div>


<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 row-cols-xm-1 mt-3">
    <% for (let listing of allListings) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card col listing-card" >
                <img src="<%= listing.image.url %>" class="card-img-top" alt="listing-image" style="height: 20rem;">
                <div class="card-img-overlay">OMMMMMMMM</div>
                <div class="card-body">
                    <p class="card-text">
                        <b><%= listing.title %></b>  <br>
                        &#8377; <%= listing.price.toLocaleString("en-IN") %> /night
                        <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
                    </p>
                </div>
            </div>
        </a>
    <% } %>
</div>



<script>
    let taxSwitch = document.getElementById("flexSwitchCheckDefault");
    taxSwitch.addEventListener("click" , () => {
        let taxInfo = document.getElementsByClassName("tax-info");
        for (let info of taxInfo) {
            if (info.style.display != "inline") {
                info.style.display = "inline";
            } else {
                info.style.display = "none";
            }
        }
    });



    //classList is a built in feature of js which stores which css style class is applied to current id or class
    //like here the activeFilter is a style feature which is defined earlier in css styles
    // let allFilters = document.getElementsByClassName("filter");
    // for (let filter of allFilters) {
    //     filter.addEventListener("click", () => {

    //         let isCurrentFilterActiveAlready = filter.classList.contains("activeFilter");

    //         for (let f of allFilters) {
    //             f.classList.remove("activeFilter");
    //         }
    //         if (!isCurrentFilterActiveAlready) {
    //             filter.classList.add("activeFilter");
    //         }
    //     });
    // }

    let category = "<%= category || '' %>";

    let allFilters = document.getElementsByClassName("filter");

    for (let filter of allFilters) {

        // Make current filter active
        if (filter.id === category) {
            filter.classList.add("activeFilter");
        }

        filter.addEventListener("click", (e) => {

            // If this filter is already active
            if (filter.classList.contains("activeFilter")) {
                e.preventDefault();     //It prevents from going to same route again
                window.location.href = "/listings";
            }

        });
}



  
    
</script>