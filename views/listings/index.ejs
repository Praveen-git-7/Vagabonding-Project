<% layout("/layouts/boilerplate") %>


<style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
    }

    .filter {
        text-align: center;
        margin-right: 2rem;
        margin-top: 2rem;
        opacity: 0.7;
        cursor: pointer;
    }
    .filter:hover {
        opacity: 1;
    }

    #filters a.activeFilter {
        opacity: 1;
        text-decoration: underline solid black 4px;
        text-underline-offset: 6px;
        font-weight: 500;
    }
    

    .filter p {
        font-size: 0.8rem;
    }

    .tax-info {
        display: none;
    }

    .tax-toggle {
        border: 1px solid black;
        border-radius: 1rem;
        height: 3.5rem;
        padding: 1rem;
        margin-left: 2rem;
        display: flex;
        align-items: center;
    }

    #filters a {
        text-decoration: none;
        color: black;
    }
</style>

<!-- <h3>Here's all your destinations </h3> -->

<!-- As its work is replaced by navbar -->
